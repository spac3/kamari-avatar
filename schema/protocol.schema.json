{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kamari-avatar/protocol.schema.json",
  "title": "Protocol",
  "description": "Kamari avatar WebSocket protocol v1. Source of truth for generated Python and TypeScript types. Binary audio frames: [u8 kind][u32 stream_id][u32 seq][payload], header big-endian, PCM16 payload little-endian; kind 0x01 = mic PCM16 16 kHz (client to server), 0x02 = TTS PCM16 (server to client).",
  "oneOf": [
    {
      "$ref": "#/$defs/ServerMessage"
    },
    {
      "$ref": "#/$defs/ClientMessage"
    }
  ],
  "$defs": {
    "Vec2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "z"
      ],
      "description": "Point on the floor plane, metres."
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": "string",
          "description": "Named location from the room manifest"
        },
        "point": {
          "$ref": "#/$defs/Vec2"
        },
        "user": {
          "type": "boolean"
        }
      },
      "required": [],
      "description": "Exactly one of location, point or user."
    },
    "VisemeKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t": {
          "type": "integer",
          "minimum": 0,
          "description": "ms from chunk start"
        },
        "v": {
          "$ref": "#/$defs/Viseme"
        }
      },
      "required": [
        "t",
        "v"
      ]
    },
    "Viseme": {
      "type": "string",
      "enum": [
        "sil",
        "PP",
        "FF",
        "TH",
        "DD",
        "kk",
        "CH",
        "SS",
        "nn",
        "RR",
        "aa",
        "E",
        "I",
        "O",
        "U"
      ],
      "description": "Oculus 15-viseme set"
    },
    "WordKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "w": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "w"
      ]
    },
    "AvatarSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "$ref": "#/$defs/Vec2"
        },
        "heading_deg": {
          "type": "number"
        }
      },
      "required": [
        "location",
        "position",
        "heading_deg"
      ]
    },
    "SessionReadyData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string"
        },
        "resume_token": {
          "type": "string"
        },
        "manifest_version": {
          "type": "string"
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tts_rate": {
              "type": "integer"
            },
            "mic_rate": {
              "type": "integer"
            }
          },
          "required": [
            "tts_rate",
            "mic_rate"
          ]
        }
      },
      "required": [
        "session_id",
        "resume_token",
        "manifest_version",
        "audio"
      ]
    },
    "SessionReadyMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "type": {
          "const": "session_ready",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ts": {
          "type": "integer",
          "description": "Unix ms"
        },
        "data": {
          "$ref": "#/$defs/SessionReadyData"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic per session, used by resume"
        }
      },
      "required": [
        "v",
        "type",
        "id",
        "ts",
        "data",
        "seq"
      ],
      "title": "SessionReadyMessage"
    },
    "WalkToData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
